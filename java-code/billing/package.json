{
  "name": "billing-app",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && concurrently -k \"npm run dev --prefix frontend\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build": "npm run build --prefix frontend && npm exec --prefix frontend -- tsc -p tsconfig.electron.json && mvn -f backend/pom.xml clean package",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.shoaib.billing",
    "productName": "Billing App",
    "directories": {
      "output": "backend/target/release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/target/billing-backend-1.0.0.jar",
        "to": "backend/billing-backend-1.0.0.jar"
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron@44.7.0": true
  }
}
