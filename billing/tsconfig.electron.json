{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["./frontend/node_modules/@types", "./node_modules/@types"]
  },
  "include": ["main.ts", "preload.ts", "database.ts", "shared/types.ts"]
}
